# =========================================================
# CELINE DATING - ENVIRONMENT VARIABLES
# =========================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=celine_dating
DB_PORT=3306
DB_POOL_SIZE=10

# JWT Configuration (for production, use a strong secret)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters
JWT_EXPIRES_IN=7d

# App Configuration
APP_NAME=Celine Dating
ADMIN_NAME=Celine
ADMIN_EMAIL=admin@celinedating.com
MAX_USERS=3000

# Security
BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional: SSL for database
# DB_SSL=true